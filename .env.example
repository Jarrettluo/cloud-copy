# cloud-copy 云复制 · 服务端配置模板
# 复制为 .env 并填入你自己的华为云 OBS 凭据（chmod 600）

# 华为云 OBS 配置
OBS_ENDPOINT=https://obs.cn-north-9.myhuaweicloud.com
OBS_REGION=cn-north-9
OBS_AK=YOUR_ACCESS_KEY_ID
OBS_SK=YOUR_SECRET_ACCESS_KEY
OBS_BUCKET=your-bucket-name
OBS_PREFIX=cloud-copy

# 限制
MAX_FILE_MB=2048
MAX_TEXT_KB=512
MAX_FILES_PER_DROP=20

# 直传（浏览器 → OBS 分片直传，不经服务器）
SINGLE_PUT_LIMIT_MB=64
MULTIPART_PART_MB=32
UPLOAD_URL_EXPIRES=21600

# 取件码字符集（A-Z 大写字母）
CODE_CHARSET=ABCDEFGHIJKLMNOPQRSTUVWXYZ
CODE_LEN=6

# 服务监听
HOST=127.0.0.1
PORT=7012
