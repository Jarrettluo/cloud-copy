# cloud-copy 云复制 · 服务端配置模板
# 复制为 .env 并填入你自己的存储凭据（chmod 600）
#
# 两种后端二选一：
#   STORAGE_BACKEND=obs  → 华为云 OBS（默认，OBS_* 配置）
#   STORAGE_BACKEND=s3   → S3 兼容存储私有部署（MinIO 等，S3_* 配置）
# 除存储凭据外，其余配置项两种后端通用。

# ============ 存储后端选择 ============
STORAGE_BACKEND=obs

# ============ 华为云 OBS（STORAGE_BACKEND=obs） ============
OBS_ENDPOINT=https://obs.cn-north-9.myhuaweicloud.com
OBS_REGION=cn-north-9
OBS_AK=YOUR_ACCESS_KEY_ID
OBS_SK=YOUR_SECRET_ACCESS_KEY
OBS_BUCKET=your-bucket-name
OBS_PREFIX=cloud-copy

# ============ MinIO / S3 兼容（STORAGE_BACKEND=s3） ============
# 私有部署：docker run -d -p 9000:9000 -p 9001:9001 \
#   -e MINIO_ROOT_USER=minioadmin -e MINIO_ROOT_PASSWORD=minioadmin \
#   -v minio-data:/data minio/minio server /data --console-address ":9001"
# 浏览器直传需要 CORS：MinIO 启动时加 -e MINIO_API_CORS_ALLOW_ORIGIN=*
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cloud-copy
S3_REGION=us-east-1
S3_LABEL=MinIO 私有部署
# 签名 URL 对外端点：浏览器能直接访问到 MinIO 的地址（Docker 内网部署时必须设置，
# 例如 http://<公网IP>:9000；裸机单地址部署可不设，默认回退到 S3_ENDPOINT）
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# MinIO 桶不存在时启动自动创建（含 CORS PUT/GET/HEAD + ETag 放行）

# ============ 限制 ============
MAX_FILE_MB=2048
MAX_TEXT_KB=512
MAX_FILES_PER_DROP=20

# ============ 直传（浏览器 → 存储分片直传，不经服务器） ============
SINGLE_PUT_LIMIT_MB=64
MULTIPART_PART_MB=32
UPLOAD_URL_EXPIRES=21600

# ============ 取件码字符集（A-Z 大写字母） ============
CODE_CHARSET=ABCDEFGHIJKLMNOPQRSTUVWXYZ
CODE_LEN=6

# ============ 服务监听 ============
HOST=127.0.0.1
PORT=7012