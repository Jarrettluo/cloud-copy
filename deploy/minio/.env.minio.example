# cloud-copy MinIO 私有部署 · 配置模板
# 复制为 .env.minio 后修改（该文件含密码，勿提交到 git）

# --- MinIO 根账号（必改，强密码） ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-please

# --- 端口（默认 9000 API / 9001 控制台） ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- 浏览器直传 CORS 兜底来源（一般保持 *） ---
MINIO_CORS_ORIGIN=*

# --- cloud-copy 后端 ---
S3_BUCKET=cloud-copy          # 桶名（不存在时自动创建）
S3_LABEL=MinIO 私有部署        # 前端「云端已连接」显示名
# 签名 URL 对外端点：浏览器能直接访问到 MinIO 的地址。
# 单机部署可保持下方默认（浏览器在本机时可访问）；远程/公网部署改成 http://<服务器IP>:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
OBS_PREFIX=cloud-copy          # 对象键前缀（沿用同一配置项，两种后端通用）
BACKEND_PORT=7012              # 后端映射到宿主机 127.0.0.1 的端口

# --- 限制（可选，默认见下） ---
MAX_FILE_MB=2048
MAX_TEXT_KB=512
SINGLE_PUT_LIMIT_MB=64
MULTIPART_PART_MB=32
CODE_CHARSET=ABCDEFGHIJKLMNOPQRSTUVWXYZ
CODE_LEN=6